// SPDX-License-Identifier: Apache-2.0
// Geometry-layer schema (docs/architecture.md). Composed into the root
// snapshot schema (schemas/snapshot.fbs; docs/format-spec.md);
// GeometrySnapshot here is a standalone root so the geometry layer can be
// round-tripped and tested in isolation first.
namespace pcbir.geometry.fbs;

// Fixed-layout: mirrors pcbir::geometry::Point exactly (int64 nanometers).
struct Point {
  x:int64;
  y:int64;
}

enum ArcDirection:ubyte { Clockwise, CounterClockwise }

// Segment/Arc are `table` (not `struct`) because FlatBuffers unions can
// only reference tables, and both participate in the Span union below.
// Point fields below are `(required)`: read_point() (serialize.cpp)
// dereferences them unconditionally, so an absent field must fail
// verification rather than reach that dereference
// (docs/format-spec.md -- Serialization fuzz target).
table Segment {
  start:Point (required);
  finish:Point (required); // "end" is a reserved word in the schema language.
}

table Arc {
  start:Point (required);
  finish:Point (required);
  center:Point (required);
  direction:ArcDirection;
}

union Span { Segment, Arc }

// `geometry` is `(required)`: this only forces the union's value offset to
// be present (a type of `NONE` is still possible on a malformed buffer;
// read_span()/read_width_span() (serialize.cpp) explicitly reject that
// case rather than reinterpreting an unrelated payload as a Segment).
table WidthSpan {
  geometry:Span (required);
  width_nm:int64;
}

// A closed loop (pcbir::geometry::Contour).
table Contour {
  spans:[Span];
}

// An open, per-span-width polyline (pcbir::geometry::Path).
table Path {
  spans:[WidthSpan];
}

// `outline` is `(required)`: read_polygon() dereferences it unconditionally.
table Polygon {
  outline:Contour (required);
  holes:[Contour];
}

table Pad {
  position:Point (required);
  outline:Polygon (required);
  layer:uint64;
  pad_number:string;
}

table Via {
  position:Point (required);
  drill_diameter_nm:int64;
  finished_hole_diameter_nm:int64;
  pad_diameter_nm:int64;
  start_layer:uint64;
  end_layer:uint64;
  pad_number:string;
}

table Track {
  path:Path (required);
  layer:uint64;
  net:uint64;
}

table CopperPour {
  outline:Polygon (required);
  layer:uint64;
  net:uint64;
}

table Keepout {
  outline:Polygon (required);
  layer:uint64;
}

table DrillHit {
  position:Point (required);
  diameter_nm:int64;
  plated:bool;
}

table MaskOpening {
  outline:Polygon (required);
  layer:uint64;
}

table SilkscreenGraphic {
  path:Path (required);
  layer:uint64;
}

enum FootprintSide:ubyte { Top, Bottom }

// A placed component grouping the Pad/Via entities that belong to it
// (docs/rfcs/0002-kicad-schema-foundation.md). `pads` holds a mix of Pad
// and Via EntityIds.
table Footprint {
  reference_designator:string;
  value:string;
  position:Point (required);
  rotation_e6:int64;
  side:FootprintSide;
  pads:[uint64];
}

// The board's mechanical boundary; `layer` must resolve to a stackup Layer
// with kind EdgeCuts. Structurally identical to CopperPour/Keepout/
// MaskOpening, kept as its own table purely for semantic distinction (the
// same reasoning as Track vs. SilkscreenGraphic).
table BoardOutline {
  outline:Polygon (required);
  layer:uint64;
}

// Every board entity also carries the stable EntityId (docs/architecture.md)
// it was assigned in the workspace it was built from, so a load -> edit ->
// save round trip preserves identity, not just shape. `value` is
// `(required)` so a buffer missing it fails FlatBuffers verification
// (docs/format-spec.md -- Serialization fuzz target) instead of reaching
// deserialize_geometry's unconditional `entry->value()` dereference.
table PadEntry { id:uint64; value:Pad (required); }
table ViaEntry { id:uint64; value:Via (required); }
table TrackEntry { id:uint64; value:Track (required); }
table CopperPourEntry { id:uint64; value:CopperPour (required); }
table KeepoutEntry { id:uint64; value:Keepout (required); }
table DrillHitEntry { id:uint64; value:DrillHit (required); }
table MaskOpeningEntry { id:uint64; value:MaskOpening (required); }
table SilkscreenGraphicEntry { id:uint64; value:SilkscreenGraphic (required); }
table FootprintEntry { id:uint64; value:Footprint (required); }
table BoardOutlineEntry { id:uint64; value:BoardOutline (required); }

table GeometrySnapshot {
  pads:[PadEntry];
  vias:[ViaEntry];
  tracks:[TrackEntry];
  copper_pours:[CopperPourEntry];
  keepouts:[KeepoutEntry];
  drill_hits:[DrillHitEntry];
  mask_openings:[MaskOpeningEntry];
  silkscreen_graphics:[SilkscreenGraphicEntry];
  footprints:[FootprintEntry];
  board_outlines:[BoardOutlineEntry];
}

root_type GeometrySnapshot;
